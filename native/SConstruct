#!/usr/bin/env python3
import os
from pathlib import Path
root = Path(Dir('..').abspath)
env = SConscript(str(root / 'work/toolchain/godot-cpp/SConstruct'), exports={'api_version': '4.7'})
env.Append(CXXFLAGS=['-ffp-contract=off', '-fno-fast-math'])
env.Append(CPPPATH=[str(root / 'native')])
lib = env.SharedLibrary(str(root / 'game/native/bin/libspice_hotpaths'), source=Glob('*.cpp'))
Default(lib)
